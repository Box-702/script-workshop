# =====================================================================
# .dockerignore —— 控制 Docker 构建上下文
#
# Dockerfile 只会复制 pyproject.toml、README.md、app/，这里再显式排除
# 本地数据、缓存与无关目录，避免把大文件/环境敏感内容发给 daemon。
# =====================================================================

.git
.claude
.gitignore

# 本地运行时数据与数据库。
data/
*.db
*.sqlite
*.sqlite3

# Python 字节码 / 包缓存。
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 环境变量（内含密钥，绝不进镜像上下文）。
.env
.env.*
!.env.example

# 测试不需要进镜像。
tests/
