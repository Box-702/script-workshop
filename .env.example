# ===== API =====
# LLM provider: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cost-tier overrides; leave empty to use OPENAI_MODEL for all
LLM_MODEL_SUMMARY=
LLM_MODEL_BIBLE=
LLM_MODEL_SCENE=
LLM_MODEL_DIALOGUE=
LLM_MODEL_REPAIR=

# Database
DATABASE_URL=sqlite:///./data/script-workshop.db

# Storage for raw/chunked text
STORAGE_DIR=./storage

# Server-side encryption key for saved user model keys.
# Use a long random value in production. Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
KEY_ENCRYPTION_KEY=

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Output language for LLM-generated natural-language values (e.g. zh-CN, en-US)
OUTPUT_LANGUAGE=zh-CN

# ===== Web =====
NEXT_PUBLIC_API_BASE=/api
BACKEND_URL=http://127.0.0.1:8000
