# ===== API =====
# LLM provider: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cost-tier overrides; leave empty to use OPENAI_MODEL for all
LLM_MODEL_SUMMARY=
LLM_MODEL_BIBLE=
LLM_MODEL_SCENE=
LLM_MODEL_DIALOGUE=
LLM_MODEL_REPAIR=

# Database
# Local default:
DATABASE_URL=sqlite:///./data/script-workshop.db
# Supabase/Postgres production example (Transaction pooler, port 6543):
# Copy the URI from Supabase Dashboard -> Database -> Settings -> Connection
# string, then:
#   1. swap the host:port to the Transaction pooler (`aws-N-<region>.pooler.supabase.com:6543`)
#   2. swap the protocol to `postgresql+psycopg` (SQLAlchemy + psycopg3)
#   3. replace `[YOUR-PASSWORD]` with your database password, percent-encoding
#      reserved characters (`+` -> `%2B`, `,` -> `%2C`, `&` -> `%26`, ...)
# Example:
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL-ENCODED-PASSWORD>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Auth
# Local development: AUTH_MODE=local (any caller is treated as a single dev user)
# Production:        AUTH_MODE=supabase (Authorization: Bearer <supabase access token>)
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage for raw/chunked text
STORAGE_DIR=./storage

# Server-side encryption key for saved user model keys.
# Use a long random value in production. Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
KEY_ENCRYPTION_KEY=

# CORS: comma-separated list of allowed origins for the API.
# Local dev defaults to the Next.js dev server on 3000; add your Vercel
# production URL (no trailing slash) when deploying.
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
# Local AUTH_MODE only: send X-Dev-User-Id to simulate another user.

# Output language for LLM-generated natural-language values (e.g. zh-CN, en-US)
OUTPUT_LANGUAGE=zh-CN

# ===== Web =====
NEXT_PUBLIC_API_BASE=/api
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
