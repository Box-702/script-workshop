# ===== API =====
# LLM provider: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cost-tier overrides; leave empty to use OPENAI_MODEL for all
LLM_MODEL_SUMMARY=
LLM_MODEL_BIBLE=
LLM_MODEL_SCENE=
LLM_MODEL_DIALOGUE=
LLM_MODEL_REPAIR=

# Database
# Local default:
DATABASE_URL=sqlite:///./data/script-workshop.db
# Supabase/Postgres production example:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Supabase/Auth placeholders for the upcoming multi-user deployment phase.
AUTH_MODE=local
# AUTH_MODE=supabase requires Authorization: Bearer <Supabase access token>
# and verifies it with SUPABASE_URL + SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage for raw/chunked text
STORAGE_DIR=./storage

# Server-side encryption key for saved user model keys.
# Use a long random value in production. Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
KEY_ENCRYPTION_KEY=

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
# Local AUTH_MODE only: send X-Dev-User-Id to simulate another user.

# Output language for LLM-generated natural-language values (e.g. zh-CN, en-US)
OUTPUT_LANGUAGE=zh-CN

# ===== Web =====
NEXT_PUBLIC_API_BASE=/api
BACKEND_URL=http://127.0.0.1:8000
