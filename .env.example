# =====================================================================
# .env.example —— 剧本智能体环境变量模板
#
# 使用：复制为 .env 后按需填写。
#   Copy-Item .env.example .env
#
# 分层：
#   - 必填：业务数据库（Postgres）。本地开发可临时改为 SQLite。
#   - 可选：对话模型（OPENAI_*）——留空则走本地规则回退，仍可跑通全流程。
#   - 可选：Milvus RAG（MILVUS_* / EMBEDDING_* / ENABLE_RAG）。
# =====================================================================

# ---------- 业务数据库（Postgres） ----------
# 与 docker-compose.yml 里的 postgres 服务保持一致。
DATABASE_URL=postgresql+psycopg://script:script@localhost:5432/script_agent
# 本地 / 测试不装 Postgres 时，可临时改成 SQLite 跑单测：
# DATABASE_URL=sqlite:///./data/dev.db

# ---------- LangGraph checkpointer ----------
# memory  = 进程内内存保活（无需服务，本地/测试用）；
# postgres= 跨请求/跨重启恢复被中断的审阅图（Docker 默认）。
CHECKPOINTER=memory
# checkpoint 专用 DSN；留空则复用 DATABASE_URL 的 postgres 库。
CHECKPOINT_DSN=

# ---------- 对话模型（OpenAI 兼容，可选） ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 使用 DeepSeek：OPENAI_BASE_URL=https://api.deepseek.com/v1, OPENAI_MODEL=deepseek-chat
OUTPUT_LANGUAGE=zh-CN

# ---------- 可选：Milvus RAG 向量检索 ----------
# 关闭时不生成向量、不启用 retrieve_source 工具；开启且 Milvus 不可达时
# 会退化为内存向量 + 哈希嵌入，功能仍可用。
ENABLE_RAG=false
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=script_chunks
MILVUS_USER=
MILVUS_PASSWORD=
# 嵌入器：openai（需 EMBEDDING_API_KEY）| hashing（离线确定性向量）。
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
