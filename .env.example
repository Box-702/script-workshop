# =====================================================================
# .env.example —— 剧本智能体环境变量模板
#
# 使用：复制为 .env 后按需填写。
#   Copy-Item .env.example .env
#
# 不填模型 key 时，应用走「本地规则回退」，仍可完整演示流程。
# =====================================================================

# ---------- 模型接入（统一由 app/llm/registry.py 解析） ----------
# 默认优先级链：OPENAI_* > ZHIPUAI_* > DEEPSEEK_*（三者都留空则走本地规则回退）。
# 想跳过优先级链直接指定厂商，取消下面这行的注释（可选值见 app/llm/providers.py）：
# CHAT_PROVIDER=deepseek      # openai | deepseek | zhipu | moonshot | qwen | ollama

# 1) OpenAI / 通义 / Moonshot 等任意 OpenAI 兼容接口：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 2) 智谱 GLM（同一个 key 也用于 CogView 文生图 / CogVideoX 视频）：
# ZHIPUAI_API_KEY=
# ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPUAI_MODEL_NAME=glm-4-flash

# 3) DeepSeek 原生（国内直连；当前推荐）：
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
# DeepSeek 深度思考开关：默认 false（关闭 thinking，速度快 ~6 倍；单次约 10s）。
# 需要更深度推理时设为 true（单次约 50s）。
DEEPSEEK_THINKING=false

# 4) Ollama 本地（无需 key；仅当 CHAT_PROVIDER=ollama 时启用）：
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---------- 视觉质检 / 文生图（留空则自动复用支持该能力的厂商 key） ----------
# 视觉质检：默认复用 DeepSeek 视觉模型（定妆图质检），也可显式指定：
# VISION_PROVIDER=zhipu
# VISION_MODEL=glm-4v-flash
# VISION_API_KEY=
# 文生图：默认 cogview（智谱），可换 openai：
# IMAGE_PROVIDER=cogview
# IMAGE_MODEL=cogview-3-flash
# IMAGE_API_KEY=

# ---------- 可选第三方服务 ----------
# Tavily 联网搜索 key：
# TAVILY_API_KEY=
# LangSmith 监控（开启后 LangGraph/LLM 运行轨迹自动上报）：
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=script-agent

# ---------- 业务数据库 ----------
# 默认指向 Postgres，需先用 `docker compose up -d` 启动数据库（用户/密码/库名见 docker-compose.yml）。
# 本机免部署 / 测试时换成下面这行 SQLite，并把 CHECKPOINTER 设为 memory。
DATABASE_URL=postgresql+psycopg://script:script@localhost:5432/script_agent
# DATABASE_URL=sqlite:///./data/dev.db

# ---------- LangGraph checkpointer ----------
# memory=进程内（零依赖）；postgres=跨请求/跨重启恢复被中断的审阅图（需上面 Postgres 起来）。
CHECKPOINTER=postgres
CHECKPOINT_DSN=postgresql://script:script@localhost:5432/script_agent

# ---------- 输出语言 / 服务 ----------
OUTPUT_LANGUAGE=zh-CN
# 默认只监听本机（服务无鉴权）；确需局域网访问再改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# ---------- 工作目录（可选落盘） ----------
# 默认 True：剧本 / 版本 / 导出 以文件形式写到项目下 data/（不存在自动创建）。
# 默认落盘到 项目下/data；可用 WORKSPACE_ROOT 换目录，设 WORKSPACE_PERSIST=false 改为仅应用内。
WORKSPACE_PERSIST=true
# WORKSPACE_ROOT=C:\Users\你\Documents\剧本工坊

# ---------- 成片质检（需视觉模型；判定只对致命问题 FAIL） ----------
# 成片后自动抽帧质检，不合格自动同参数重 roll（次数有界）。
VIDEO_QA_ENABLED=true
VIDEO_QA_MAX_REROLL=1
VIDEO_QA_FRAMES=5
# ffmpeg 路径（抽帧/拼接用；留空用 PATH 里的 ffmpeg）
# FFMPEG_PATH=
