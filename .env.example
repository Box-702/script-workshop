# =====================================================================
# .env.example —— 剧本智能体环境变量模板
#
# 使用：复制为 .env 后按需填写。
#   Copy-Item .env.example .env
#
# 不填模型 key 时，应用走「本地规则回退」，仍可完整演示流程。
# =====================================================================

# ---------- 对话模型（二选一，OPENAI_* 优先级更高） ----------
# OpenAI / 通义 / Moonshot 等任意 OpenAI 兼容接口：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# DeepSeek 原生（当前推荐，国内直连）：
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
# DeepSeek 深度思考开关：默认 false（关闭 thinking，速度快 ~6 倍；单次约 10s）。
# 需要更深度推理时设为 true（单次约 50s）。
DEEPSEEK_THINKING=false

# ---------- 可选第三方服务 ----------
# 智谱 AI 嵌入（RAG 向量化，OpenAI 兼容；有 ZHIPUAI_API_KEY 时自动接管嵌入）：
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPUAI_MODEL_NAME=embedding-3
# Tavily 联网搜索 key（预留，暂未接入工具）：
# TAVILY_API_KEY=
# LangSmith 监控（开启后 LangGraph/LLM 运行轨迹自动上报）：
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=script-agent

# ---------- 业务数据库（Postgres，docker compose 启动） ----------
# 与 docker-compose.yml 的 postgres 服务保持一致（用户 script / 密码 script）。
POSTGRES_PASSWORD=script
DATABASE_URL=postgresql+psycopg://script:script@localhost:5432/script_agent
# 本地 / 测试不装 Postgres 时可临时改成 SQLite：
# DATABASE_URL=sqlite:///./data/dev.db

# ---------- LangGraph checkpointer ----------
# memory=进程内；postgres=跨请求/跨重启恢复被中断的审阅图（推荐）。
CHECKPOINTER=postgres
CHECKPOINT_DSN=postgresql://script:script@localhost:5432/script_agent

# ---------- 可选向量检索（RAG，docker compose --profile milvus 启动） ----------
ENABLE_RAG=true
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=script_chunks
# 嵌入：openai（用 ZHIPUAI_API_KEY 时自动接管）| hashing（离线哈希演示）
EMBEDDING_PROVIDER=openai
# 智谱 embedding-3 原生维度 2048；换模型请按需调整（代码会自动探测真实维度）。
EMBEDDING_DIM=2048

# ---------- 输出语言 / 服务 ----------
OUTPUT_LANGUAGE=zh-CN
API_HOST=0.0.0.0
API_PORT=8000

# ---------- 工作目录（可选落盘） ----------
# 默认 True：剧本 / 版本 / 导出 以文件形式写到项目下 data/（不存在自动创建）。
# 默认落盘到 项目下/data；可用 WORKSPACE_ROOT 换目录，设 WORKSPACE_PERSIST=false 改为仅应用内。
WORKSPACE_PERSIST=true
# WORKSPACE_ROOT=C:\Users\你\Documents\剧本工坊
