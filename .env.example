# =====================================================================
# .env.example —— 问剧环境变量模板
#
# 使用：复制为 .env 后按需填写。
#   Copy-Item .env.example .env
#
# 不填模型 key 时，应用走「本地规则回退」，仍可完整演示流程。
#
# ⚠️ 有两类参数：一类由 pydantic `Settings` 直接读 .env；另一类（多 key 轮换、
# FFMPEG_PATH、LANGSMITH_*）是代码直接读 os.environ 的。两类都依赖入口调用
# `config.bootstrap_env()`——`app/main.py` 与 `app/cli.py` 已经这样做了。
# 自己写脚本时记得也调一次，否则这些参数会静默取默认值。
# =====================================================================

# ---------- 模型接入（统一由 app/llm/registry.py 解析） ----------
# 默认优先级链：OPENAI_* > ZHIPUAI_* > DEEPSEEK_*（三者都留空则走本地规则回退）。
# 想跳过优先级链直接指定厂商，取消下面这行的注释：
# CHAT_PROVIDER=deepseek      # openai | deepseek | zhipu | minimax | moonshot | qwen | ollama

# 1) OpenAI / 通义 / Moonshot 等任意 OpenAI 兼容接口：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 2) 智谱 GLM（同一个 key 也用于 CogView 文生图）：
# ZHIPUAI_API_KEY=
# ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPUAI_MODEL_NAME=glm-4-flash

# 3) DeepSeek（国内直连；当前推荐）：
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
# 深度思考开关：默认 false（关闭 thinking，快约 6 倍）；需要深推理时设 true。
DEEPSEEK_THINKING=false

# 4) Ollama 本地（无需 key；仅当 CHAT_PROVIDER=ollama 时启用）：
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---------- 视觉质检 / 文生图（留空则自动复用支持该能力的厂商 key） ----------
# 视觉质检（定妆图/成片抽帧质检）；默认复用 DeepSeek 视觉模型：
# VISION_PROVIDER=deepseek
# VISION_MODEL=deepseek-v4-flash-vision-exp
# VISION_API_KEY=
# VISION_BASE_URL=
# 文生图（参考资产/定妆照）；默认 cogview（智谱）：
# IMAGE_PROVIDER=cogview          # cogview | openai
# IMAGE_MODEL=cogview-3-flash
# IMAGE_API_KEY=
# IMAGE_BASE_URL=

# ---------- 业务数据库 ----------
# 开发默认 SQLite（零部署，文件落在 data/ 下）：
# DATABASE_URL=sqlite:///./data/script_agent.db
# 需要 Postgres 时先 `docker compose up -d`，再换成：
# DATABASE_URL=postgresql+psycopg://script:script@localhost:5432/script_agent

# ---------- Agent 工作流 checkpointer ----------
# memory=进程内（零依赖，开发默认）；postgres=跨请求/跨重启恢复被中断的审阅图。
CHECKPOINTER=memory
# CHECKPOINT_DSN=postgresql://script:script@localhost:5432/script_agent

# ---------- 输出语言 / 服务 ----------
OUTPUT_LANGUAGE=zh-CN
# 默认只监听本机（服务无鉴权）；确需局域网访问再改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# ---------- 工作目录 ----------
# persist=true：剧本/版本/导出 以文件写到 data/（不存在自动创建）；
# persist=false：只在应用内，不落盘（数据仍在数据库里）。
WORKSPACE_PERSIST=true
# WORKSPACE_ROOT=C:\Users\你\Documents\剧本工坊

# ---------- 视频生成 / 配音：MiniMax（一把 key 打通 H3 出片 + T2A 配音） ----------
# 主 key；留空则视频/配音链路自动禁用（前端会提示未配置）。
# MINIMAX_API_KEY=
# 备用 key（逗号分隔，可写多把）：主 key 欠费/失效时自动顶上，顺序即优先级。
# 坏掉的 key 进冷却，冷却期内不再试；充值后无需重启，冷却到期自动复活。
# MINIMAX_API_KEY_FALLBACKS=
# 旧写法别名（与上一行等价，同时存在时按出现顺序合并去重）：
# MINIMAX_API_KEYS=
# 冷却时长（秒），缺省 600。
# KEY_COOLDOWN_SEC=600
# 对话用的 MiniMax 端点与模型（CHAT_PROVIDER=minimax 时生效）：
# MINIMAX_BASE_URL=https://api.minimax.cn/v1
# MINIMAX_MODEL_NAME=MiniMax-Text-01

# ---------- 配音（TTS） ----------
# 留空 TTS_API_KEY 时回落 MINIMAX_API_KEY（与视频同厂商，零配置可用）。
# TTS_PROVIDER=minimax
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=speech-02-hd
# 台词混音时的环境音音量（0-1），防止人声被盖住。
# DUBBING_BG_VOLUME=0.25

# ---------- 视频生成全局策略 ----------
# 首次生成用低挡位快速廉价出片，满意后再按高清晰度重生成。
# VIDEO_DEFAULT_RESOLUTION=768P
# 孤儿任务巡检：把「DB 说还在跑、内存没人盯」的任务重新挂回轮询（不会重复提交）。
# VIDEO_SWEEPER_ENABLED=true
# VIDEO_SWEEPER_INTERVAL_SEC=60

# ---------- 成片质检（需视觉模型；判定只对致命问题 FAIL） ----------
# VIDEO_QA_ENABLED=true
# VIDEO_QA_MAX_REROLL=1
# VIDEO_QA_FRAMES=5
# ffmpeg 路径（抽帧/拼接用；留空用 PATH 里的 ffmpeg）
# FFMPEG_PATH=

# ---------- 剧本评审打分 ----------
# ENABLE_REVIEW_SCORING=true
# REVIEW_SCORE_THRESHOLD=75

# ---------- LangSmith 监控（可选） ----------
# 开启后 LangGraph/LLM 运行轨迹自动上报；启动时映射为 LANGCHAIN_* 环境变量。
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=script-agent
