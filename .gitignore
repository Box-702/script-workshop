# =====================================================================
# .gitignore —— 只提交「项目相关」代码，忽略本地工作产物与敏感信息
# =====================================================================

# ---------- 环境/密钥（含真实 API key，严禁提交） ----------
.env
.env.local
.env.*.local
.env.*.bak
*.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---------- 本地数据与数据库 ----------
data/
*.db
*.sqlite
*.sqlite3

# ---------- 测试 / 工具缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
pytest-cache-files-*/

# ---------- 前端（Vue）依赖与构建产物 ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------- 本地开发脚本 / 工具 ----------
clear_db.py
*.log

# ---------- 编辑器 / 系统 / 本地 Agent ----------
.idea/
.vscode/
.DS_Store
.claude/
.dsh/
*.local
