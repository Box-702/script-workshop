# =====================================================================
# .gitignore —— 忽略本地运行时产物，避免把密钥和数据提交到 Git。
# =====================================================================

# 环境变量（含密钥）不入库。
.env

# Python。*
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# 本地数据与数据库。
data/
*.db
*.sqlite
*.sqlite3

# 测试与工具缓存。
.pytest_cache/
.ruff_cache/
.mypy_cache/
pytest-cache-files-*/

# 编辑器 / 系统。
.idea/
.vscode/
.DS_Store
