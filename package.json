{
  "name": "scriptforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI 小说转剧本工作台 monorepo",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @scriptforge/api dev",
    "dev:web": "pnpm --filter @scriptforge/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf node_modules .next dist && rm -rf node_modules"
  }
}
