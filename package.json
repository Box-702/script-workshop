{
  "name": "script-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "AI 小说转剧本工作台 monorepo",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "clean": "node scripts/clean.mjs"
  }
}
