{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptforge.ai/schema/script.schema.json",
  "title": "ScriptForge Script",
  "description": "YAML/JSON schema for ScriptForge AI generated scripts.",
  "type": "object",
  "required": ["script"],
  "additionalProperties": false,
  "properties": {
    "script": {
      "type": "object",
      "required": [
        "title",
        "version",
        "language",
        "source",
        "logline",
        "characters",
        "locations",
        "scenes"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "故事标题"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "language": {
          "type": "string",
          "description": "BCP-47, e.g. zh-CN, en-US"
        },
        "adaptation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["series", "film", "short_drama", "stage", "other"]
            },
            "target_format": {
              "type": "string"
            },
            "tone": {
              "type": "string"
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["chapter_count", "chapter_ids"],
          "additionalProperties": false,
          "properties": {
            "chapter_count": {
              "type": "integer",
              "minimum": 3
            },
            "chapter_ids": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "pattern": "^chapter_[0-9]{3,}$"
              }
            }
          }
        },
        "logline": {
          "type": "string",
          "minLength": 10
        },
        "themes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/character" }
        },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scene" }
        }
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^char_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["protagonist", "antagonist", "supporting", "mentor", "foil", "other"]
        },
        "goal": { "type": "string" },
        "motivation": { "type": "string" },
        "personality": { "type": "string" },
        "relationship": { "type": "string" },
        "arc": { "type": "string" },
        "speech_style": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^loc_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "title",
        "chapter_refs",
        "location_id",
        "characters",
        "purpose",
        "conflict"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^scene_[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "chapter_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^chapter_[0-9]{3,}$" }
        },
        "location_id": { "type": "string", "pattern": "^loc_[a-z0-9_]+$" },
        "time": { "type": "string" },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^char_[a-z0-9_]+$" }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "conflict": { "type": "string", "minLength": 1 },
        "entry_state": { "type": "string" },
        "exit_state": { "type": "string" },
        "action": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dialogue": {
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        },
        "adaptation_notes": { "$ref": "#/$defs/adaptation_notes" }
      }
    },
    "line": {
      "type": "object",
      "required": ["speaker", "line"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string", "pattern": "^char_[a-z0-9_]+$" },
        "line": { "type": "string", "minLength": 1 },
        "emotion": { "type": "string" },
        "subtext": { "type": "string" }
      }
    },
    "adaptation_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "fidelity": {
          "type": "string",
          "enum": ["faithful", "compressed", "reordered", "merged", "invented"]
        }
      }
    }
  }
}
