@echo off
rem =====================================================================
rem start.bat -- one-key start (Windows)
rem
rem What it does:
rem   1. checks uv / npm are available
rem   2. creates a zero-dependency .env (SQLite + in-memory checkpointer)
rem      on first run -- edit .env to add your model keys (see .env.example)
rem   3. syncs Python deps, builds the frontend if frontend/dist is missing
rem   4. serves backend + built frontend in ONE process on port 8000
rem
rem Dev mode (hot reload) is different: see README "Development".
rem =====================================================================
setlocal
cd /d "%~dp0"

where uv >nul 2>nul
if errorlevel 1 (
  echo [ERROR] uv not found. Install it first: https://docs.astral.sh/uv/getting-started/installation/
  pause
  exit /b 1
)

if not exist .env (
  echo [SETUP] No .env found -- creating zero-dependency config ^(SQLite, no Postgres needed^)...
  > .env echo # Auto-generated by start.bat. For all options ^(model keys, Postgres, Tavily...^) see .env.example
  >> .env echo DATABASE_URL=sqlite:///./data/app.db
  >> .env echo CHECKPOINTER=memory
  >> .env echo DEEPSEEK_API_KEY=
  >> .env echo OUTPUT_LANGUAGE=zh-CN
  echo [SETUP] .env created. Add your model key in .env to enable full AI features
  echo         ^(without a key the app runs in local-rule demo mode^).
)

echo [SETUP] Syncing Python dependencies ...
uv sync --frozen
if errorlevel 1 (
  echo [ERROR] uv sync failed. Check the message above.
  pause
  exit /b 1
)

if not exist frontend\dist\index.html (
  echo [SETUP] Building frontend ^(first run only^) ...
  where npm >nul 2>nul
  if errorlevel 1 (
    echo [ERROR] npm not found. Install Node.js 20+: https://nodejs.org/
    pause
    exit /b 1
  )
  pushd frontend
  if not exist node_modules (
    npm ci
    if errorlevel 1 (popd & echo [ERROR] npm ci failed & pause & exit /b 1)
  )
  npm run build
  if errorlevel 1 (popd & echo [ERROR] frontend build failed & pause & exit /b 1)
  popd
)

echo.
echo  ============================================================
echo   Script Workshop  -^>  http://127.0.0.1:8000
echo   Press Ctrl+C to stop. Keep this window open.
echo  ============================================================
echo.
start "" http://127.0.0.1:8000
uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
pause
